# Local reference material — kept on disk, deliberately not checked in.
# Feedback/brainstorm/brand source docs and finished hand-off briefs live in archive/.
# NOTE: nothing in here is backed up by git. Keep your own copy of anything you'd miss.
*.docx
/archive/

# Generated Netlify deploy copy (regenerate with netlify.toml's build command — it needs js/ too)
/site/

# AWS SAM build artifacts
backend/.aws-sam/

# Node
node_modules/

# Local Claude config. Most of .claude/ is local-only, but the multi-model workflow
# (subagents, slash commands, the GPT wrapper) is tracked on purpose: each Desktop session
# gets a fresh worktree, and gitignored files don't come along — an untracked workflow would
# silently not exist there.
.claude/*
!.claude/launch.json
!.claude/agents/
!.claude/skills/
!.claude/gpt/
.claude/gpt/*
!.claude/gpt/ask.sh

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
.vscode/
*.tmp
*-extracted.txt
